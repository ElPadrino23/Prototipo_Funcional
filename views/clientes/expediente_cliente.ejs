<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
<%- include('./../nav.ejs') %>

<main class="app-page">
    <div class="app-header">
        <div>
            <h1 class="app-title">Nuevo Expediente de Cliente</h1>
            <p class="app-subtitle">Completa los tres pasos para registrar un nuevo cliente.</p>
        </div>
        <a href="/clientes/lista" class="btn secondary">Volver a la lista</a>
    </div>

    <!-- Indicador de pasos -->
    <div style="display:flex; gap:8px; margin-bottom:18px;">
        <div id="ind1" style="flex:1; padding:10px 16px; border-radius:6px; background:var(--azul-principal); color:white; font-size:13px; font-weight:600;">1 · Datos Generales</div>
        <div id="ind2" style="flex:1; padding:10px 16px; border-radius:6px; background:white; border:1px solid var(--borde); color:var(--muted); font-size:13px;">2 · Documentos</div>
        <div id="ind3" style="flex:1; padding:10px 16px; border-radius:6px; background:white; border:1px solid var(--borde); color:var(--muted); font-size:13px;">3 · Resumen</div>
    </div>

    <!-- Paso 1: Datos Generales -->
    <div id="paso1">
        <section class="panel">
            <div class="form-grid">
                <div>
                    <label for="nombre">Nombre / Razon Social</label>
                    <input type="text" id="nombre" required>
                </div>
                <div>
                    <label for="rfc">RFC</label>
                    <input type="text" id="rfc" required>
                </div>
                <div>
                    <label for="curp">CURP</label>
                    <input type="text" id="curp">
                </div>
                <div>
                    <label for="tipoCliente">Tipo de cliente</label>
                    <select id="tipoCliente">
                        <option value="Fisica">Persona Fisica</option>
                        <option value="Moral">Persona Moral</option>
                    </select>
                </div>
                <div>
                    <label for="estatusCliente">Estatus</label>
                    <select id="estatusCliente">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                        <option value="En revision">En revision</option>
                    </select>
                </div>
                <div>
                    <label for="contactoPrincipal">Contacto principal</label>
                    <input type="text" id="contactoPrincipal">
                </div>
                <div>
                    <label for="telefono">Telefono</label>
                    <input type="text" id="telefono">
                </div>
                <div>
                    <label for="correo">Correo electronico</label>
                    <input type="email" id="correo">
                </div>
                <div>
                    <label for="calle">Calle y numero</label>
                    <input type="text" id="calle">
                </div>
                <div>
                    <label for="colonia">Colonia</label>
                    <input type="text" id="colonia">
                </div>
                <div>
                    <label for="ciudad">Ciudad</label>
                    <input type="text" id="ciudad">
                </div>
                <div>
                    <label for="estado">Estado</label>
                    <input type="text" id="estado">
                </div>
                <div>
                    <label for="codigoPostal">Codigo postal</label>
                    <input type="text" id="codigoPostal">
                </div>
                <div>
                    <label for="limiteOperativo">Limite autorizado (MXN)</label>
                    <input type="number" id="limiteOperativo" min="0">
                </div>
                <div style="grid-column: 1 / -1;">
                    <label for="observaciones">Observaciones</label>
                    <textarea id="observaciones" rows="3" style="width:100%; resize:vertical;"></textarea>
                </div>
                <div style="grid-column: 1 / -1; display:flex; align-items:center; gap:10px;">
                    <label style="display:flex; align-items:center; gap:8px; margin:0; cursor:pointer;">
                        <input type="checkbox" id="esPEP">
                        <span style="font-weight:400; color:var(--texto);">Es Persona Expuesta Politicamente (PEP)</span>
                    </label>
                </div>
                <div style="grid-column: 1 / -1;">
                    <p style="margin:0; font-size:13px; color:var(--muted);">
                        Nivel de riesgo calculado:
                        <strong id="nivelRiesgo" style="color:var(--azul-oscuro);">Bajo</strong>
                    </p>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn" onclick="irPaso2()">Siguiente: Documentos &rarr;</button>
            </div>
        </section>
    </div>

    <!-- Paso 2: Documentos -->
    <div id="paso2" style="display:none">
        <section class="panel">
            <div class="form-grid">
                <div>
                    <label for="ine">INE o Pasaporte</label>
                    <input type="file" id="ine" style="padding:8px 0;">
                </div>
                <div>
                    <label for="compDomicilio">Comprobante de domicilio</label>
                    <input type="file" id="compDomicilio" style="padding:8px 0;">
                </div>
                <div>
                    <label for="docRfc">RFC (documento)</label>
                    <input type="file" id="docRfc" style="padding:8px 0;">
                </div>
                <div>
                    <label for="docCurp">CURP (documento)</label>
                    <input type="file" id="docCurp" style="padding:8px 0;">
                </div>
                <div>
                    <label for="constancia">Constancia de situacion fiscal</label>
                    <input type="file" id="constancia" style="padding:8px 0;">
                </div>
            </div>
            <div class="form-actions">
                <button class="btn secondary" onclick="irPaso1()">&larr; Anterior</button>
                <button class="btn" onclick="irPaso3()">Siguiente: Resumen &rarr;</button>
            </div>
        </section>
    </div>

    <!-- Paso 3: Resumen -->
    <div id="paso3" style="display:none">
        <section class="panel">
            <div id="resumen" class="form-grid"></div>
            <div class="form-actions">
                <button class="btn secondary" onclick="irPaso2()">&larr; Anterior</button>
                <button class="btn" onclick="guardarExpediente()">Guardar Expediente</button>
            </div>
        </section>
    </div>
</main>

<script>
    document.getElementById('esPEP').addEventListener('change', calcularRiesgo);
    document.getElementById('limiteOperativo').addEventListener('input', calcularRiesgo);

    function calcularRiesgo() {
        const esPEP  = document.getElementById('esPEP').checked;
        const limite = parseFloat(document.getElementById('limiteOperativo').value) || 0;
        let riesgo   = 'Bajo';

        if (esPEP) {
            riesgo = 'Alto';
        } else if (limite > 1500000) {
            riesgo = 'Medio';
        }

        document.getElementById('nivelRiesgo').textContent = riesgo;
    }

    function setIndicador(paso) {
        [1, 2, 3].forEach(function(i) {
            const el = document.getElementById('ind' + i);
            if (i === paso) {
                el.style.background = 'var(--azul-principal)';
                el.style.color = 'white';
                el.style.border = 'none';
            } else {
                el.style.background = 'white';
                el.style.color = 'var(--muted)';
                el.style.border = '1px solid var(--borde)';
            }
        });
    }

    function irPaso1() {
        document.getElementById('paso1').style.display = 'block';
        document.getElementById('paso2').style.display = 'none';
        document.getElementById('paso3').style.display = 'none';
        setIndicador(1);
    }

    function irPaso2() {
        const nombre = document.getElementById('nombre').value.trim();
        const rfc    = document.getElementById('rfc').value.trim();

        if (!nombre || !rfc) {
            alert('Nombre y RFC son obligatorios');
            return;
        }

        document.getElementById('paso1').style.display = 'none';
        document.getElementById('paso2').style.display = 'block';
        document.getElementById('paso3').style.display = 'none';
        setIndicador(2);
    }

    function irPaso3() {
        const riesgo = document.getElementById('nivelRiesgo').textContent;

        const campos = [
            ['Nombre',           document.getElementById('nombre').value],
            ['RFC',              document.getElementById('rfc').value],
            ['CURP',             document.getElementById('curp').value || '-'],
            ['Tipo',             document.getElementById('tipoCliente').value],
            ['Estatus',          document.getElementById('estatusCliente').value],
            ['Contacto',         document.getElementById('contactoPrincipal').value || '-'],
            ['Telefono',         document.getElementById('telefono').value || '-'],
            ['Correo',           document.getElementById('correo').value || '-'],
            ['Calle',            document.getElementById('calle').value || '-'],
            ['Colonia',          document.getElementById('colonia').value || '-'],
            ['Ciudad',           document.getElementById('ciudad').value || '-'],
            ['Estado',           document.getElementById('estado').value || '-'],
            ['Codigo postal',    document.getElementById('codigoPostal').value || '-'],
            ['Limite operativo', '$' + (document.getElementById('limiteOperativo').value || 0)],
            ['Es PEP',           document.getElementById('esPEP').checked ? 'Si' : 'No'],
            ['Nivel de riesgo',  riesgo],
            ['Observaciones',    document.getElementById('observaciones').value || '-'],
        ];

        document.getElementById('resumen').innerHTML = campos.map(function(c) {
            return '<div><label>' + c[0] + '</label><div class="readonly-field">' + c[1] + '</div></div>';
        }).join('');

        document.getElementById('paso1').style.display = 'none';
        document.getElementById('paso2').style.display = 'none';
        document.getElementById('paso3').style.display = 'block';
        setIndicador(3);
    }

    async function guardarExpediente() {
        const formData = new FormData();

        formData.append('nombre',            document.getElementById('nombre').value);
        formData.append('rfc',               document.getElementById('rfc').value);
        formData.append('curp',              document.getElementById('curp').value);
        formData.append('tipoCliente',       document.getElementById('tipoCliente').value);
        formData.append('estatusCliente',    document.getElementById('estatusCliente').value);
        formData.append('contactoPrincipal', document.getElementById('contactoPrincipal').value);
        formData.append('telefono',          document.getElementById('telefono').value);
        formData.append('correo',            document.getElementById('correo').value);
        formData.append('calle',             document.getElementById('calle').value);
        formData.append('colonia',           document.getElementById('colonia').value);
        formData.append('ciudad',            document.getElementById('ciudad').value);
        formData.append('estado',            document.getElementById('estado').value);
        formData.append('codigoPostal',      document.getElementById('codigoPostal').value);
        formData.append('limiteOperativo',   document.getElementById('limiteOperativo').value);
        formData.append('esPEP',             document.getElementById('esPEP').checked ? 'Sí' : 'No');
        formData.append('nivelRiesgo',       document.getElementById('nivelRiesgo').textContent);
        formData.append('observaciones',     document.getElementById('observaciones').value);

        const archivos = [
            { id: 'ine',           nombre: 'INE' },
            { id: 'compDomicilio', nombre: 'Domicilio' },
            { id: 'docRfc',        nombre: 'RFC' },
            { id: 'docCurp',       nombre: 'CURP' },
            { id: 'constancia',    nombre: 'ConstanciaFiscal' }
        ];

        archivos.forEach(function(a) {
            const input = document.getElementById(a.id);
            if (input.files[0]) {
                formData.append(a.nombre, input.files[0]);
            }
        });

        try {
            const resp   = await fetch('/clientes/expediente', { method: 'POST', body: formData });
            const result = await resp.json();

            if (result.exito) {
                alert('Expediente guardado, su ID: ' + result.idCliente);
                window.location.href = '/clientes/lista';
            } else {
                alert('Error: ' + result.error);
            }
        } catch (err) {
            alert('Error al guardar: ' + err.message);
        }
    }
</script>
</body>
</html>
