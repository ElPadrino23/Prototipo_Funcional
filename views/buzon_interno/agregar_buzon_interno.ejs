<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
<%- include('./../nav.ejs') %>

<main class="app-page">
    <div class="app-header">
        <div>
            <h1 class="app-title">Buzon Interno</h1>
            <p class="app-subtitle">Reporta una conducta de manera anonima</p>
        </div>
        <a href="/buzon-interno/lista" class="btn secondary">Volver</a>
    </div>

    <section class="panel">
        <form action="/buzon-interno/agregar" method="POST">

            <div style="margin-bottom:16px;">
                <label style="display:block;margin-bottom:7px;color:var(--azul-oscuro);font-size:13px;font-weight:600;">Descripcion de la conducta sospechosa</label>
                <textarea name="descripcion" rows="5" required style="width:100%;border:1px solid var(--borde);border-radius:6px;padding:10px 12px;resize:vertical;font-size:14px;"></textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label>
                    <input type="checkbox" name="anonimo" value="true">
                    Se enviara de manera automatica <!-- o noooo-->
                </label>
            </div>

            <div class="form-actions"> <!-- Hay que corregir por que no le pusimos boton jeje-->
                <button type="submit" class="btn">Enviar reporte</button>
            </div>

        </form>
    </section>
</main>

<%- include('./../scripts.ejs') %>
</body>
</html>
