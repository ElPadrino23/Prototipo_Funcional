<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
<%- include('./../nav.ejs') %>

<main class="app-page">
    <div class="app-header">
        <div>
            <h1 class="app-title">Buzón Interno</h1>
            <p class="app-subtitle">Los reportes no revelan la identidad</p>
        </div>
        <a href="/buzon-interno/agregar" class="btn">Nuevo reporte</a>
    </div>

    <% if (mensaje) { %>
        <div class="feedback"><%= mensaje %></div>
    <% } %>

    <section class="panel">
        <table class="striped responsive-table">
            <thead>
                <tr>
                    <th style="white-space:nowrap;">ID</th>
                    <th>Descripción</th>
                    <th style="white-space:nowrap;">Anónimo</th>
                    <th style="white-space:nowrap;">Estatus</th>
                    <th style="white-space:nowrap;">Fecha</th>
                    <% if (usuario && usuario.rol !== 'Cliente') { %><th style="white-space:nowrap;">Acciones</th><% } %>
                </tr>
            </thead>
            <tbody>
                <% if (reportes.length === 0) { %>
                    <tr><td colspan="<%= usuario && usuario.rol !== 'Cliente' ? 6 : 5 %>" style="color:var(--muted)">Sin reportes registrados</td></tr>
                <% } %>
                <% reportes.forEach(function(r) { %>
                    <tr>
                        <td><%= r.id %></td>
                        <td style="min-width:240px;"><%= r.descripcion %></td>
                        <td style="white-space:nowrap;"><%= r.anonimo ? 'Sí' : 'No' %></td>
                        <%
                            var estatusKey   = String(r.estatus || '').toLowerCase().replace('_', ' ');
                            var estatusTexto = 'Pendiente';
                            var estatusClase = 'badge-warn';
                            if (estatusKey === 'en revision' || estatusKey === 'en investigacion') {
                                estatusTexto = 'En revisión';
                                estatusClase = 'badge-warn';
                            } else if (estatusKey === 'cerrado') {
                                estatusTexto = 'Cerrado';
                                estatusClase = 'badge-ok';
                            }
                        %>
                        <td style="white-space:nowrap;"><span class="badge-soft <%= estatusClase %>"><%= estatusTexto %></span></td>
                        <td style="white-space:nowrap;"><%= r.fecha || '—' %></td>
                        <% if (usuario && usuario.rol !== 'Cliente') { %>
                        <td style="white-space:nowrap;">
                            <% var estatusNorm = String(r.estatus || '').toLowerCase(); %>
                            <% if (estatusNorm !== 'cerrado') { %>
                            <form action="/buzon-interno/actualizar" method="POST" style="display:flex;align-items:center;gap:8px;">
                                <input type="hidden" name="id" value="<%= r.id %>">
                                <input type="hidden" name="responsable" value="<%= r.responsable || '' %>">
                                <select name="estatus" class="browser-default" style="border:1px solid var(--borde);border-radius:6px;padding:8px 10px;font-size:13px;min-height:38px;min-width:140px;width:auto;">
                                    <option value="Pendiente"   <%= estatusNorm === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                                    <option value="En revision" <%= (estatusNorm === 'en revision' || estatusNorm === 'en_investigacion') ? 'selected' : '' %>>En revisión</option>
                                    <option value="Cerrado"     <%= estatusNorm === 'cerrado' ? 'selected' : '' %>>Cerrado</option>
                                </select>
                                <button type="submit" class="btn-small btn">Guardar</button>
                            </form>
                            <% } %>
                        </td>
                        <% } %>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>
</main>

<%- include('./../scripts.ejs') %>
</body>
</html>
