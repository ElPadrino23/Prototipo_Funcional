<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
<%- include('./../nav.ejs') %>

<main class="app-page">
    <div class="app-header">
        <div>
            <h1 class="app-title">Editar usuario</h1>
            <p class="app-subtitle">Modifica los datos del perfil de acceso.</p>
        </div>
        <a href="/admin/lista" class="btn secondary">Volver a la lista</a>
    </div>

    <% if (typeof mensaje !== 'undefined' && mensaje) { %>
        <div class="feedback <%= mensaje.tipo === 'error' ? 'error' : '' %>"><%= mensaje.texto %></div>
    <% } %>

    <section class="panel">
        <form action="/admin/editar" method="POST">

            <input type="hidden" name="idusuario" value="<%= usuario.idusuario %>">

            <div class="form-grid">
                <div>
                    <label for="nombre">Nombre</label>
                    <input type="text" name="nombre" id="nombre" value="<%= usuario.nombre || '' %>" required>
                </div>

                <div>
                    <label for="apellido">Apellido</label>
                    <input type="text" name="apellido" id="apellido" value="<%= usuario.apellido || '' %>">
                </div>

                <div>
                    <label for="correo">Correo</label>
                    <input type="email" name="correo" id="correo" value="<%= usuario.correo || '' %>" required>
                </div>

                <div>
                    <label for="rol">Rol</label>
                    <select name="rol" id="rol" required>
                        <option value="Analista"                <%= (usuario.rol || '') === 'Analista'                ? 'selected' : '' %>>Analista</option>
                        <option value="Oficial de Cumplimiento" <%= (usuario.rol || '') === 'Oficial de Cumplimiento' ? 'selected' : '' %>>Oficial de Cumplimiento</option>
                    </select>
                </div>

                <div>
                    <label for="estado">Estado</label>
                    <select name="estado" id="estado" required>
                        <option value="Activo"   <%= (usuario.estado || '') === 'Activo'   ? 'selected' : '' %>>Activo</option>
                        <option value="Inactivo" <%= (usuario.estado || '') === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Guardar cambios</button>
            </div>

        </form>
    </section>
</main>

<%- include('./../scripts.ejs') %>
</body>
</html>
